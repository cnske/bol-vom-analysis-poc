df2$Date <- as.Date(df2$Month, format="%Y-%m")
df2$Date <- as.Date(df2$Month, format="%Y-%m-01")
monthly <- list(
setNames(aggregate(df1$Temperature_d, by=list(df$Month), FUN=mean, na.rm=TRUE),
c("MonthY", "Temperature_m")),
setNames(aggregate(df1$Precipitation_d, by=list(df$Month), FUN=sum, na.rm=TRUE),
c("MonthY", "Precipitation_m")) )
df2 <- monthly %>% reduce(full_join, by= "MonthY")
df2$Month <- as.factor(str_sub(df2$MonthY, end=2))
df2$Month <- as.factor(str_sub(df2$MonthY, start=-2))
