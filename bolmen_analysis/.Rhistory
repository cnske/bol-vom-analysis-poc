df1$Month <- as.factor(substring(df1$Date, 0, 7))
monthly <- list(
setNames(aggregate(df1$Temperature_d, by=list(df$Month), FUN=mean, na.rm=TRUE), c("Month", "Temperature_m")),
setNames(aggregate(df1$Precipitation_d, by=list(df$Month), FUN=sum, na.rm=TRUE), c("Month", "Precipitation_m")) )
